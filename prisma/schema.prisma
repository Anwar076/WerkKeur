generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  EMPLOYEE
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum SubcontractorComputedStatus {
  COMPLIANT
  ATTENTION
  ACTION_REQUIRED
}

enum DocumentReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RequestStatus {
  OPEN
  PARTIAL
  COMPLETE
  EXPIRED
  REVOKED
}

enum RequestItemStatus {
  REQUESTED
  RECEIVED
}

enum ReminderType {
  DOCUMENT_EXPIRATION
  REQUEST_MISSING_DOCUMENT
  MANUAL
}

enum NotificationType {
  DOCUMENT_EXPIRING
  DOCUMENT_RECEIVED
  ACTION_REQUIRED
  REQUEST_UPDATE
  TEAM_UPDATE
  SYSTEM
}

enum PlanTier {
  STARTER
  BUSINESS
  PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  CANCELED
  PAST_DUE
  EXPIRED
}

enum ActivityAction {
  SUBCONTRACTOR_CREATED
  SUBCONTRACTOR_UPDATED
  DOCUMENT_UPLOADED
  DOCUMENT_REPLACED
  DOCUMENT_DELETED
  REQUEST_SENT
  REMINDER_SENT
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  TEAM_MEMBER_ADDED
  TEAM_MEMBER_UPDATED
  SETTINGS_UPDATED
}

model User {
  id                    String               @id @default(cuid())
  firstName             String
  lastName              String
  email                 String               @unique
  passwordHash          String
  emailVerifiedAt       DateTime?
  currentOrganizationId String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  currentOrganization   Organization?        @relation("CurrentOrganization", fields: [currentOrganizationId], references: [id], onDelete: SetNull)
  memberships           OrganizationMember[]
  passwordResetTokens   PasswordResetToken[]
  sentRequests          DocumentRequest[]    @relation("RequestSender")
  reviewedDocuments     Document[]           @relation("DocumentReviewer")
  uploadedDocuments     Document[]           @relation("DocumentUploader")
  notifications         Notification[]
  activities            ActivityLog[]
  triggeredReminders    Reminder[]           @relation("ReminderTriggerUser")

  @@index([currentOrganizationId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Organization {
  id                     String               @id @default(cuid())
  name                   String
  kvkNumber              String?
  addressLine1           String?
  postalCode             String?
  city                   String?
  country                String               @default("Nederland")
  email                  String?
  phone                  String?
  onboardingCompleted    Boolean              @default(false)
  subcontractorRange     String?
  reminderDaysBefore30   Boolean              @default(true)
  reminderDaysBefore14   Boolean              @default(true)
  reminderDaysBefore7    Boolean              @default(true)
  reminderOnExpiration   Boolean              @default(true)
  requestReminderAfter3  Boolean              @default(true)
  requestReminderAfter7  Boolean              @default(true)
  requestReminderAfter14 Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  members                OrganizationMember[]
  usersWithCurrentOrg    User[]               @relation("CurrentOrganization")
  subcontractors         Subcontractor[]
  documentTypes          DocumentType[]
  documents              Document[]
  documentRequests       DocumentRequest[]
  reminders              Reminder[]
  notifications          Notification[]
  activityLogs           ActivityLog[]
  subscription           Subscription?
  invitations            TeamInvitation[]
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           Role
  status         MembershipStatus @default(ACTIVE)
  invitedAt      DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Subcontractor {
  id               String                     @id @default(cuid())
  organizationId   String
  companyName      String
  kvkNumber        String?
  vatNumber        String?
  contactFirstName String?
  contactLastName  String?
  contactEmail     String?
  contactPhone     String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  lastActivityAt   DateTime?
  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requirements     SubcontractorRequirement[]
  documents        Document[]
  documentRequests DocumentRequest[]

  @@index([organizationId, companyName])
  @@index([organizationId, lastActivityAt])
}

model DocumentType {
  id                     String                     @id @default(cuid())
  organizationId         String
  name                   String
  description            String?
  requiresExpirationDate Boolean                    @default(true)
  isRequiredByDefault    Boolean                    @default(false)
  defaultValidityMonths  Int?
  reminderDays           Int                        @default(30)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  organization           Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requirements           SubcontractorRequirement[]
  documents              Document[]
  requestItems           DocumentRequestItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model SubcontractorRequirement {
  id              String        @id @default(cuid())
  organizationId  String
  subcontractorId String
  documentTypeId  String
  required        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  subcontractor   Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  documentType    DocumentType  @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  @@unique([subcontractorId, documentTypeId])
  @@index([organizationId, subcontractorId])
}

model Document {
  id               String               @id @default(cuid())
  organizationId   String
  subcontractorId  String
  documentTypeId   String
  requestItemId    String?              @unique
  originalFilename String
  storageKey       String               @unique
  mimeType         String
  fileSize         Int
  issueDate        DateTime?
  expirationDate   DateTime?
  uploadedAt       DateTime             @default(now())
  reviewedAt       DateTime?
  reviewStatus     DocumentReviewStatus @default(PENDING)
  rejectionReason  String?
  uploadedById     String?
  reviewedById     String?
  deletedAt        DateTime?
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subcontractor    Subcontractor        @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  documentType     DocumentType         @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  uploadedBy       User?                @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  reviewedBy       User?                @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  requestItem      DocumentRequestItem? @relation(fields: [requestItemId], references: [id])
  reminders        Reminder[]

  @@index([organizationId, subcontractorId])
  @@index([organizationId, expirationDate])
  @@index([organizationId, documentTypeId])
}

model DocumentRequest {
  id                 String                @id @default(cuid())
  organizationId     String
  subcontractorId    String
  sentById           String?
  tokenHash          String                @unique
  tokenExpiresAt     DateTime
  revokedAt          DateTime?
  sentAt             DateTime              @default(now())
  lastReminderSentAt DateTime?
  status             RequestStatus         @default(OPEN)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subcontractor      Subcontractor         @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  sentBy             User?                 @relation("RequestSender", fields: [sentById], references: [id], onDelete: SetNull)
  items              DocumentRequestItem[]
  reminders          Reminder[]

  @@index([organizationId, subcontractorId])
  @@index([organizationId, status])
  @@index([tokenExpiresAt])
}

model DocumentRequestItem {
  id                String            @id @default(cuid())
  documentRequestId String
  documentTypeId    String
  status            RequestItemStatus @default(REQUESTED)
  fulfilledAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  documentRequest   DocumentRequest   @relation(fields: [documentRequestId], references: [id], onDelete: Cascade)
  documentType      DocumentType      @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  uploadedDocument  Document?

  @@unique([documentRequestId, documentTypeId])
}

model Reminder {
  id                String           @id @default(cuid())
  organizationId    String
  type              ReminderType
  reminderKey       String           @unique
  recipientEmail    String
  scheduledFor      DateTime
  sentAt            DateTime?
  failedAt          DateTime?
  lastError         String?
  metadata          Json?
  documentId        String?
  documentRequestId String?
  subcontractorId   String?
  triggeredById     String?
  createdAt         DateTime         @default(now())
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document          Document?        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentRequest   DocumentRequest? @relation(fields: [documentRequestId], references: [id], onDelete: Cascade)
  triggeredBy       User?            @relation("ReminderTriggerUser", fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([organizationId, scheduledFor])
  @@index([organizationId, sentAt])
}

model Notification {
  id                String           @id @default(cuid())
  organizationId    String
  recipientUserId   String
  type              NotificationType
  title             String
  message           String
  readAt            DateTime?
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime         @default(now())
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipientUser     User             @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, readAt])
  @@index([organizationId, createdAt])
}

model ActivityLog {
  id             String         @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         ActivityAction
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser      User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
}

model Subscription {
  id                     String             @id @default(cuid())
  organizationId         String             @unique
  plan                   PlanTier           @default(STARTER)
  status                 SubscriptionStatus @default(TRIALING)
  trialEndsAt            DateTime
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?
  cancelAt               DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
}

model TeamInvitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           Role
  tokenHash      String           @unique
  invitedById    String?
  status         MembershipStatus @default(INVITED)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId, status])
}
